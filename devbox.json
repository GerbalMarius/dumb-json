{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.19.0/.schema/devbox.schema.json",
  "packages": [
    "cargo@latest",
    "rustup@latest",
    "rustc@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": [
        "cargo test --verbose"
      ],
      "clean" : [
        "cargo clean"
      ],
      "build" : [
        "cargo build --verbose"
      ]
    }
  }
}
