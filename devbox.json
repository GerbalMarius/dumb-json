{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.19.0/.schema/devbox.schema.json",
  "name": "Environment for running ci/cd for rust",
  "packages": [
    "rustup@latest"
  ],
  "shell": {
    "init_hook": [
      "rustup default stable"
    ],
    "scripts": {
      "test": [
        "cargo test --verbose"
      ],
      "clean": [
        "cargo clean"
      ],
      "build": [
        "cargo build --verbose"
      ]
    }
  }
}